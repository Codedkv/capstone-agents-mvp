# ============================================================================
# Capstone-Agents-MVP / Outlier — environment variables
# ============================================================================
# Copy this file to .env and fill in real values. .env is gitignored.
# DO NOT put real keys here — this file IS committed to the public repo.

# Google Gemini API key (REQUIRED)
# Obtain from: https://aistudio.google.com/app/apikey
# Either name works — the code checks GOOGLE_API_KEY first, then GEMINI_API_KEY.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional: override the default input metrics file
# Default if unset: data/shipments_data.xlsx
# METRICS_FILE=data/shipments_data.xlsx
